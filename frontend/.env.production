# Public, non-secret build config for production-mode builds (Vercel production AND preview builds).
# The GTM container id is visible in every page's source, so it is safe in git. analytics.ts only loads GTM on
# daveenci.ai / www.daveenci.ai, so preview deploys send nothing. Container JSON: docs/gtm/daveenci-ai-container.json
VITE_GTM_ID=GTM-NHZP8KWM
